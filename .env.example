LUNA_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Якщо вказано інший OpenAI-сумісний API (Ollama, OpenRouter, Groq...) —
# голосові рушії не підтримуються (mode: off), Луна показує підказку.

# ─── Голосовий рушій (тільки для основного API OpenAI) ───────
# live     = GPT-Live (gpt-live-1): full-duplex, слухає, поки говорить
# realtime = GPT-Realtime (gpt-realtime): напівдуплекс, VAD
LUNA_REALTIME_ENGINE=live
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-realtime
# Голос Луни (обома рушіями)
OPENAI_VOICE=marin

# Адреса сервера (127.0.0.1 — тільки цей комп'ютер)
HOST=127.0.0.1
PORT=8787
